generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime? // Soft Delete

  categories            Category[]
  transactions          Transaction[]
  workoutPlans          WorkoutPlan[]
  sessions              WorkoutSession[]
  recurringTransactions RecurringTransaction[]
  tasks                 Task[]
  exercises             Exercise[]

  // Relações do Módulo de Nutrição
  foods                 Food[]
  mealLogs              MealLog[]
  weightLogs            WeightLog[]
  nutritionGoal         NutritionGoal?

  @@index([email, deletedAt])
}

model Category {
  id        String       @id @default(uuid())
  name      String
  type      CategoryType
  userId    String?
  user      User?        @relation(fields: [userId], references: [id])
  deletedAt DateTime? // Soft Delete

  transactions          Transaction[]
  exercises             Exercise[]
  recurringTransactions RecurringTransaction[]

  @@index([userId, type, deletedAt])
}

enum CategoryType {
  INCOME
  EXPENSE
  FITNESS
}

enum PaymentMethod {
  DEBIT
  CREDIT
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
  YEARLY
}

model RecurringTransaction {
  id            String              @id @default(uuid())
  amount        Decimal             @db.Decimal(12, 2)
  description   String
  frequency     RecurrenceFrequency
  startDate     DateTime
  endDate       DateTime?
  nextDate      DateTime
  isActive      Boolean             @default(true)
  paymentMethod PaymentMethod       @default(DEBIT)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  deletedAt     DateTime? // Soft Delete

  userId String
  user   User   @relation(fields: [userId], references: [id])

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  transactions Transaction[]

  @@index([userId, isActive, nextDate, deletedAt])
}

model Transaction {
  id            String        @id @default(uuid())
  amount        Decimal       @db.Decimal(12, 2)
  description   String?
  date          DateTime      @default(now())
  categoryId    String
  category      Category      @relation(fields: [categoryId], references: [id])
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  paymentMethod PaymentMethod @default(DEBIT)
  deletedAt     DateTime? // Soft Delete

  recurringTransactionId String?
  recurringTransaction   RecurringTransaction? @relation(fields: [recurringTransactionId], references: [id])

  @@index([userId, date, paymentMethod, deletedAt])
}

model WorkoutPlan {
  id        String    @id @default(uuid())
  name      String
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  deletedAt DateTime? // Soft Delete

  exercises WorkoutPlanExercise[]
  sessions  WorkoutSession[]

  @@index([userId, deletedAt])
}

model Exercise {
  id         String   @id @default(uuid())
  name       String
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  deletedAt DateTime? // Soft Delete

  setLogs              SetLog[]
  workoutPlanExercises WorkoutPlanExercise[]

  @@index([userId, categoryId, deletedAt])
}

model WorkoutPlanExercise {
  id            String      @id @default(uuid())
  workoutPlanId String
  workoutPlan   WorkoutPlan @relation(fields: [workoutPlanId], references: [id])
  exerciseId    String
  exercise      Exercise    @relation(fields: [exerciseId], references: [id])
  
  targetSets    Int         @default(0)
  targetMinReps Int         @default(0)
  targetMaxReps Int         @default(0)

  createdAt     DateTime    @default(now())

  @@unique([workoutPlanId, exerciseId])
  @@index([workoutPlanId])
  @@index([exerciseId])
}

model WorkoutSession {
  id            String      @id @default(uuid())
  workoutPlanId String
  workoutPlan   WorkoutPlan @relation(fields: [workoutPlanId], references: [id])
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  startedAt     DateTime    @default(now())
  finishedAt    DateTime?
  deletedAt     DateTime? // Soft Delete

  setLogs SetLog[]

  @@index([userId, startedAt, deletedAt])
}

model SetLog {
  id               String         @id @default(uuid())
  workoutSessionId String
  workoutSession   WorkoutSession @relation(fields: [workoutSessionId], references: [id])
  exerciseId       String
  exercise         Exercise       @relation(fields: [exerciseId], references: [id])
  reps             Int
  weight           Decimal        @db.Decimal(10, 2)
  toFailure        Boolean        @default(false)
  createdAt        DateTime       @default(now())
  deletedAt        DateTime? // Soft Delete

  @@index([exerciseId, createdAt, deletedAt])
  @@index([workoutSessionId, deletedAt])
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

model Task {
  id          String       @id @default(uuid())
  title       String
  description String?
  priority    TaskPriority @default(MEDIUM)
  status      TaskStatus   @default(TODO)
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime? // Soft Delete

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@index([userId, priority, status, deletedAt]) 
}

// ==========================================
// ENUMS DO MÓDULO DE NUTRIÇÃO
// ==========================================

enum ServingUnit {
  GRAM
  MILLILITER
  UNIT
  TABLESPOON
  TEASPOON
  SCOOP
  CUP
}

enum MealType {
  BREAKFAST
  MORNING_SNACK
  LUNCH
  AFTERNOON_SNACK
  DINNER
  SUPPER
  SNACK
}

enum ActivityLevel {
  SEDENTARY
  LIGHTLY_ACTIVE
  MODERATELY_ACTIVE
  VERY_ACTIVE
  EXTRA_ACTIVE
}

enum BiologicalSex {
  MALE
  FEMALE
}

// ==========================================
// MODELOS DO MÓDULO DE NUTRIÇÃO
// ==========================================

model Food {
  id          String      @id @default(uuid())
  name        String
  brand       String?
  servingSize Decimal     @db.Decimal(10, 2)
  servingUnit ServingUnit @default(GRAM)

  calories    Decimal     @db.Decimal(10, 2)
  protein     Decimal     @db.Decimal(10, 2)
  carbs       Decimal     @db.Decimal(10, 2)
  fat         Decimal     @db.Decimal(10, 2)
  fiber       Decimal?    @db.Decimal(10, 2)

  userId      String?
  user        User?       @relation(fields: [userId], references: [id])

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?

  mealItems   MealFoodItem[]

  @@index([userId, name, deletedAt])
}

model MealLog {
  id        String    @id @default(uuid())
  date      DateTime  @db.Date
  mealType  MealType  @default(LUNCH)
  notes     String?

  userId    String
  user      User      @relation(fields: [userId], references: [id])

  items     MealFoodItem[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([userId, date, deletedAt])
}

model MealFoodItem {
  id                 String   @id @default(uuid())
  mealLogId          String
  mealLog            MealLog  @relation(fields: [mealLogId], references: [id], onDelete: Cascade)

  foodId             String
  food               Food     @relation(fields: [foodId], references: [id])

  quantity           Decimal  @db.Decimal(10, 2)

  consumedCalories   Decimal  @db.Decimal(10, 2)
  consumedProtein    Decimal  @db.Decimal(10, 2)
  consumedCarbs      Decimal  @db.Decimal(10, 2)
  consumedFat        Decimal  @db.Decimal(10, 2)
  consumedFiber      Decimal? @db.Decimal(10, 2)

  createdAt          DateTime @default(now())

  @@index([mealLogId])
  @@index([foodId])
}

model WeightLog {
  id        String    @id @default(uuid())
  weight    Decimal   @db.Decimal(6, 2)
  date      DateTime  @default(now())
  notes     String?

  userId    String
  user      User      @relation(fields: [userId], references: [id])

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@index([userId, date, deletedAt])
}

model NutritionGoal {
  id             String    @id @default(uuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id])

  targetCalories Decimal   @db.Decimal(10, 2)
  targetProtein  Decimal   @db.Decimal(10, 2)
  targetCarbs    Decimal   @db.Decimal(10, 2)
  targetFat      Decimal   @db.Decimal(10, 2)
  targetFiber    Decimal?  @db.Decimal(10, 2)

  targetWeight   Decimal?  @db.Decimal(6, 2)

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId])
}